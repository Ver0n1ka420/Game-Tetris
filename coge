from  tkinter import *
import random
from colorsys import hsv_to_rgb # функция для красивых цветов

W, H, S = 10, 20, 30 # ширина, высота, размер в пикселях
CIAN = "#32ffc1"
RED = "red"
WHITE = "white"
SHAPES = [
    [(0, 0), (1, 0), (2, 0), (3, 0)], # I
    [(0, 0), (1, 0), (0, 1), (1, 1)], # O
    [(1, 0), (0, 1), (1, 1), (2, 1)], # T
    [(0, 0), (1, 0), (1, 1), (2, 1)], # Z
    [(1, 0), (2, 0), (0, 1), (1, 1)], # S
    [(0, 0), (0, 1), (1, 1), (2, 1)], # J
    [(0, 2), (0, 1), (1, 1), (2, 1)] # L
]
DX = {"Left": -1, "Right": 1} # управление мышкой

board = [[0] * W for _ in range(H)]
score = 0
alive = True # пока игра идет
kind = random.randrange(7) # номер текущей фигуры
nxt = random.randrange(7) # следующей
piece = list(SHAPES[kind]) # клетки текущей фигуры
px, py = 3, 0 # координаты

root = Tk()
root.title("Тетрис")
c = Canvas(root, width=W * S + 150, height=H * S, bg="#0f1020")
c.pack()

def color(i): # цвет по номеру фигуры
    r, g, b = hsv_to_rgb(i/7, .7, 255)
    return "#%02x%02x%02x" % (int(r), int(g), int(b))

def cell(x, y, i): # рисует клетку фигуры
    c.create_rectangle(x * S + 2, y * S + 2, x * S + S - 2, y * S + S - 2,
                       fill=color(i), outline="")

def ghost (x, y, i): # рисует тень фигуры
    c.create_rectangle(x * S + 3, y * S + 3, x * S + S - 3, y * S + S - 3,
                       fill=color(i), width=2)

def label(x, y, t, size, col): # текст
    c.create_text(x, y, text=t, fill=col, font=("Arial", size, "bold"))

def fits(p, x, y): # вычисляет помещается ли фигура в место
    for a, b in p:
        cx, cy = x + a, y + b # считает координаты
        if not 0 <= cx < W or cy >= H: # если вышли за стенку
            return False
        if board[cy][cx]: # если клетка занята
            return False
    return True

def rotate(p): # поворачивает фигуру
    q = [(-b, a) for a, b in p] # поворот на 90 градусов
    x = min(a for a, b in q)
    y = min(b for a, b in q)
    return [(a-x, b-y) for a, b in q]

def spawn(): # запускает новую фигуру
    global kind, nxt, piece
    global px, py, alive
    kind = nxt # "следующая" становится "текущей"
    nxt = random.randrange(7) # запуск рандомной
    piece = list(SHAPES[kind])
    px, py = 3, 0
    alive = fits(piece, px, py) # alive будет труе если есть место

def clear(): # убирает заполненык линии
    global board, score
    rs = [r for r in board if 0 in r]
    n = H - len(rs) # сколько линий исчезло
    new = [[0] * W for _ in range(n)]
    board = new + rs # добавляет столько же
    score += (0, 1, 3, 5, 8)[n] * 100

def lock(): # фиксирует упавшую фигуру
    for a, b in piece:
        board[py+b][px+a] = kind + 1
    clear() # проверяет место
    spawn() # запускает новую

def drop(): # двигает фигуру на клетку вниз
    global py
    if fits(piece, px, py + 1):
        py += 1
    else:
        lock() # фигура приземлилась, фиксирует координаты

def key(e): # реакция на клавиши
    global px, piece
    k = e.keysym # название клавиши
    dx = DX.get(k, 0)
    if fits(piece, px + dx, py):
        px += dx # если фигура помещается, двигает
    if k == "Up": # поворот фигуры
        r = rotate(piece)
        if fits(r, px, py):
            piece = r
    if k == "Down": # ускорение падения
        drop()
    draw() # каждый раз перерисовываем

def draw():
    c.delete("all")
    for y in range(H): # проходит по полю
        for x in range(W): # каждую клетку рисует своим цветом
            v = board[y][x]
            if v:
                cell(x, y, v - 1)
    gy = py # просчет тени
    while fits(piece, px, gy + 1):
        gy += 1
    for a, b in piece: # тень
        ghost(px + a, gy + b, kind)
    for a, b in piece: # фигура
        cell(px + a, py + b, kind)
    x = W * S
    c.create_line(x, 0, x, H * S, fill="#2a2d55", width=3)
    m = x + 75
    label(m, 50, "Счёт", 20, WHITE)
    label(m, 90, score, 28, CIAN)
    label(m, 160, "Дальше", 16, WHITE)
    for a, b in SHAPES[nxt]:
        cell(W + 1 + a, 6 + b, nxt)

def step():
    if alive: # если игра идет
        drop() # опускает фигуру
        draw() # рисует
        ms = max(80, 500 - score // 5) # чем больше очков, тем быстрее
        root.after(ms, step)
    else:
        t = "Game Over"
        label(150, 300, t, 30, RED)

root.bind("<KeyPress>", key) # привязка клавиш
step()
root.mainloop()
